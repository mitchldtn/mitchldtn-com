---
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import "../styles/global.css";
import { canonical } from "../lib/urls";
import { isExternal } from "../lib/external-links";

interface Props {
  title: string;
  cardTitle?: string;
  description: string;
  path: string;
  image?: string;
  noindex?: boolean;
}

const { title, cardTitle = title, description, path, image = "/og/site.png", noindex = false } = Astro.props;
const site = Astro.site!.toString();
const url = canonical(site, path);
const imageUrl = new URL(image, site).toString();
const year = new Date().getFullYear();
const isPost = /^\/writing\/(?!topic\/)[^/]+$/.test(path);

const nav = [
  { label: "writing", href: "/writing" },
  { label: "projects", href: "/projects" },
  { label: "about", href: "/about" },
];
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);

const footerLinks = [
  { label: "github", href: "https://github.com/mitchldtn" },
  { label: "linkedin", href: "https://www.linkedin.com/in/mitchldtn/" },
  { label: "rss", href: "/rss.xml" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={isPost ? "article" : "website"} />
    <meta property="og:site_name" content="Mitch Ludington" />
    <meta property="og:title" content={cardTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={cardTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#E0787B" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#151a22" />
    <link rel="alternate" type="application/rss+xml" title="Mitch Ludington: writing" href="/rss.xml" />

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-C4MMDM32HK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-C4MMDM32HK");
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="mx-auto w-full max-w-[1000px] px-5">
      <div class="flex flex-wrap items-center justify-between gap-3 py-[22px]">
        <a href="/" class="text-[15px] no-underline hover:text-redish">mitch ludington</a>
        <nav aria-label="main">
          <ul class="flex flex-wrap gap-3 text-xs sm:gap-[22px] sm:text-sm">
            {
              nav.map(({ label, href }) => (
                <li>
                  {isCurrent(href) ? (
                    <a href={href} aria-current="page" class="text-greyish underline">
                      {label}
                    </a>
                  ) : (
                    <a href={href} class="hover:text-redish">
                      {label}
                    </a>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-[30px] bg-black py-[26px] text-[13px]">
      <div class="mx-auto flex max-w-[1000px] flex-wrap justify-between gap-3 px-5">
        <span>© {year} mitch ludington</span>
        <ul class="flex flex-wrap gap-[18px]">
          {
            footerLinks.map(({ label, href }) => (
              <li>
                {isExternal(href, site) ? (
                  <a href={href} target="_blank" rel="noopener noreferrer" class="hover:text-redish">
                    {label}
                  </a>
                ) : (
                  <a href={href} class="hover:text-redish">
                    {label}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </footer>
  </body>
</html>
