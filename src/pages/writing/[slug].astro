---
import { render } from "astro:content";
import Post from "../../layouts/Post.astro";
import { posts, type Post as PostRecord } from "../../lib/content";

export async function getStaticPaths() {
  return (await posts()).map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: PostRecord };
const { Content } = await render(post.entry);
---

<Post post={post}>
  <Content />
</Post>
