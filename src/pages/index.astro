---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import NemonikPieces from "../components/NemonikPieces.astro";
import PostList from "../components/PostList.astro";
import photo from "../assets/mitch-and-boots.jpg";
import { posts } from "../lib/content";
import { beta, cliRepo, docs } from "../lib/links";
import { latest } from "../lib/posts";

const newest = latest(await posts(), 3);
---

<Base
  title="Mitch Ludington: making AI-assisted software development more reliable"
  description="I build software, explore agentic engineering workflows and share what works, what fails and why."
  path="/"
>
  <div class="mx-auto max-w-[1000px] px-5">
    <section class="grid items-center gap-10 pt-[46px] pb-14 md:grid-cols-[1.3fr_1fr]">
      <div>
        <p class="mb-[18px] text-sm text-dim">
          Engineer<span class="text-redish">.</span> Maker<span class="text-redish">.</span> Builder<span class="text-redish">.</span>
        </p>
        <h1 class="mb-[18px] text-[26px] leading-[1.3] font-normal md:text-[34px]">
          Making AI-assisted software development more reliable.
        </h1>
        <p class="mb-6 text-base leading-[1.7] text-dim">
          I build software, explore agentic engineering workflows and share what works, what fails and why.
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="btn btn-primary" href="/writing">Read the writing</a>
          <a class="btn" href="#now-building">What I'm building</a>
        </div>
      </div>
      <Image
        src={photo}
        alt="mitch (right) & boots (left)"
        widths={[400, 600, 800, 1200]}
        sizes="(min-width: 768px) 420px, calc(100vw - 40px)"
        loading="eager"
        class="h-auto w-full rounded-md"
      />
    </section>

    {
      newest.length > 0 && (
        <section class="blk" data-section="latest-writing">
          <h2 class="sec">latest writing</h2>
          <PostList posts={newest} />
          <p class="muted mt-4">
            <a href="/writing" class="underline hover:text-redish">All writing →</a> · <a href="/rss.xml" class="underline hover:text-redish">RSS</a>
          </p>
        </section>
      )
    }

    <section class="blk">
      <h2 class="sec">the problem</h2>
      <p class="border-l-[3px] border-redish py-1 pl-[18px] text-base leading-[1.75]">
        My agent had my workflow and still skipped steps. The more rules and context I added, the less consistently it
        followed them.
      </p>
      <div class="mt-7 grid gap-3.5 md:grid-cols-3">
        <div class="card text-[13.5px]">
          <div class="mb-1.5 text-greyish">Start over</div>
          Open a new session and let the agent work it out again.
        </div>
        <div class="card text-[13.5px]">
          <div class="mb-1.5 text-greyish">Patch it</div>
          Keep growing an instruction file, keep notes, paste summaries into the next session.
        </div>
        <div class="card border-2 border-greyish text-[13.5px]">
          <div class="mb-1.5 text-greyish">Build it into the workflow</div>
          Give each step its own setup and carry what was learned into the next session.
        </div>
      </div>
      <p class="mt-7 text-base leading-[1.75]">I'm building nemonik around the third approach.</p>
    </section>

    <section class="blk" id="now-building">
      <h2 class="sec">now building</h2>
      <div class="rounded-[10px] border-2 border-greyish bg-blackish p-6 sm:p-[26px]">
        <div class="eyebrow">nemonik · the workflow layer for coding agents</div>
        <h3 class="mb-3 text-xl leading-[1.4] font-normal">
          Give coding agents a repeatable workflow, the right tools for each step and the context to continue where the
          last session left off.
        </h3>
        <p class="mb-[22px] text-base leading-[1.7] text-dim">
          nemonik breaks the workflow into kits, one per step, each with its own system prompt, skills, MCP servers and
          hooks, so the agent only gets what that step needs.
        </p>

        <figure
          class="overflow-hidden rounded-[10px] border border-white/15 bg-term shadow-[0_20px_50px_-12px_rgba(0,0,0,0.7)]"
          data-demo
        >
          <figcaption class="flex items-center gap-2 border-b border-white/10 bg-[#1f242c] px-3.5 py-2.5 text-xs text-dim">
            <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
            <span class="size-2.5 rounded-full bg-[#febc2e]"></span>
            <span class="size-2.5 rounded-full bg-[#28c840]"></span>
            <span class="ml-2 truncate">taskboard-demo · a real nemonik run</span>
          </figcaption>
          <div class="relative">
            <video
              class="block w-full"
              src="/media/nemonik-demo-v1.mp4"
              poster="/media/nemonik-demo-v1.webp"
              width="1200"
              height="676"
              controls
              muted
              playsinline
              preload="none"
              aria-label="A real nemonik run: the plan kit asks a question, you approve, the build kit opens on its own, builds test-first, the review kit approves and the specs are updated."
            ></video>
            <button
              type="button"
              hidden
              class="absolute inset-0 flex items-center justify-center bg-black/25 transition hover:bg-black/10"
              aria-label="Play the demo"
            >
              <span class="rounded-full bg-redish px-5 py-3 text-sm text-navy shadow-lg">▶ Watch · 0:34</span>
            </button>
          </div>
        </figure>
        <script is:inline>
          for (const demo of document.querySelectorAll("[data-demo]")) {
            const video = demo.querySelector("video");
            const play = demo.querySelector("button");
            video.controls = false;
            play.hidden = false;
            play.addEventListener("click", () => {
              play.hidden = true;
              video.controls = true;
              video.play();
            });
          }
        </script>

        <div class="mt-6">
          <NemonikPieces />
        </div>

        <div class="mt-6 border-t border-faint pt-6" data-cta="nemonik">
          <h3 class="mb-2.5 text-lg leading-normal font-normal">
            Use Claude Code or Codex every day? Try nemonik on one real ticket.
          </h3>
          <p class="muted">
            Run one ticket your usual way and one with a kit and compare.
          </p>
          <div class="mt-[22px] grid gap-4 md:grid-cols-[1fr_1.6fr]">
            <div class="flex flex-col gap-3.5 rounded-lg border border-faint p-[18px]">
              <div class="text-xs text-greyish">Start local</div>
              <p class="flex-1 text-[13px] leading-[1.65] text-dim">local kits, no account</p>
              <div><a class="btn btn-primary" href={cliRepo} target="_blank" rel="noopener noreferrer">Install the CLI</a></div>
            </div>
            <div class="flex flex-col gap-3.5 rounded-lg border border-faint p-[18px]">
              <div class="text-xs text-greyish">Join the beta</div>
              <p class="flex-1 text-[13px] leading-[1.65] text-dim">
                With the MCP, your kits, context and memory live in one place you can share, your agents search it by
                meaning and you can reach it from Claude or GPT on your phone.
              </p>
              <div><a class="btn" href={beta} target="_blank" rel="noopener noreferrer">Join the beta</a></div>
            </div>
          </div>
          <p class="mt-3.5 text-right text-[13px] text-dim">
            <a href={docs} target="_blank" rel="noopener noreferrer" class="underline hover:text-redish">Docs</a> →
          </p>
        </div>
      </div>
    </section>
  </div>
</Base>
